	)
	(text "Power   : +12V (J1, protected) -> +5V buck -> +3V3 LDO.  +12V also feeds the beam-power output (J9)."
		(exclude_from_sim no)
		(at 25.4 182.88 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "e91f67e0-c841-57e0-b5d2-10e9be61fa50")
	)
	(text "MCU     : ESP32-S3-WROOM-1-N16R8. Native USB-C for flash/console; J4 UART0, J5 JTAG headers."
		(exclude_from_sim no)
		(at 25.4 189.23 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "82d27393-930c-5521-bcf5-92fdf3957948")
	)
	(text "Ethernet: W5500_CS/SCLK/MOSI/MISO/INT/RST  (IO10/12/11/13/9/8).  LINKLED also drives the NET LED."
		(exclude_from_sim no)
		(at 25.4 195.58 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "120b8eea-efc8-57ac-8a03-f8ad858b5631")
	)
	(text "Relays  : RELAY_1 IO4 (OPEN), RELAY_2 IO5 (CLOSE), RELAY_3 IO1, RELAY_4 IO2 (spare)  ->  K1..K4  ->  J7."
		(exclude_from_sim no)
		(at 25.4 201.93 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "ccd173d0-e714-54e5-b560-576ee0eb9d3c")
	)
	(text "Inputs  : LIM_OPEN IO6, LIM_CLOSED IO7, SAFETY_BEAM IO15  <-  protected inputs  <-  J8."
		(exclude_from_sim no)
		(at 25.4 208.28 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "a591984d-f494-5ecf-9390-d08251edb418")
	)
	(text "RS-485  : RS485_TX IO21, RS485_RX IO14, RS485_DE IO38  ->  SP3485  ->  J10 (reserved, ADR-008)."
		(exclude_from_sim no)
		(at 25.4 214.63 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "a2301ca0-2348-5cad-a4b1-3f6e5038b4db")
	)
	(text "Status  : LED_RED IO16, LED_GREEN IO17, LED_YELLOW IO18 (firmware StatusLed)."

*.plan
models/**/*.onnx
models/weights/
models/downloads/

# Data
simulation/datasets/
*.mkv *.mp4 *.avi
*.pcap *.pcd *.bag
*.log

# SQLite
*.db *.db-journal *.sqlite *.sqlite3

# Secrets — never commit
.env .env.*
secrets/
*.pem *.key
!**/*.pub
ota-signing.key
ssh_host_keys/

# Node / dashboard frontend
node_modules/
dist/
.next/

# Python (used by export scripts only)
__pycache__/
*.pyc
.venv/ venv/

# OS cruft
.DS_Store Thumbs.db

# ESP-IDF per-developer + per-build artifacts
firmware/sdkconfig
firmware/sdkconfig.old
firmware/dependencies.lock
firmware/managed_components/

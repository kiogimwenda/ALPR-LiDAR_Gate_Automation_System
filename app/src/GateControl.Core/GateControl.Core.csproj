<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything below the UI: API + live-feed clients, models, motion
       physics and view models. No MAUI dependency, so it is unit-tested
       on any machine (tests/GateControl.Core.Tests). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GateControl.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GateControl.Core.Tests" />
  </ItemGroup>

</Project>

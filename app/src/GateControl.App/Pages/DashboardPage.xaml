<?xml version="1.0" encoding="utf-8" ?>
<p:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:p="clr-namespace:GateControl.Pages"
            xmlns:c="clr-namespace:GateControl.Controls"
            xmlns:m="clr-namespace:GateControl.Motion"
            xmlns:vm="clr-namespace:GateControl.Core.ViewModels;assembly=GateControl.Core"
            xmlns:models="clr-namespace:GateControl.Core.Models;assembly=GateControl.Core"
            x:Class="GateControl.Pages.DashboardPage"
            x:Name="Page"
            x:DataType="vm:DashboardViewModel">
    <ContentPage.Resources>
        <!-- One metric tile. -->
        <DataTemplate x:Key="MetricTile" x:DataType="vm:Metric">
            <Border Style="{StaticResource Card}" Margin="0,0,12,12" FlexLayout.Basis="160" FlexLayout.Grow="1"
                    Padding="14,12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Title}" Style="{StaticResource Footnote}" />
                    <Label Text="{Binding Value}" Style="{StaticResource BigNumber}"
                           TextColor="{Binding Tone, Converter={StaticResource ToneColor}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding Tone}" Value="Neutral">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LabelLight}, Dark={StaticResource LabelDark}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="{Binding Caption}" Style="{StaticResource Caption}"
                           IsVisible="{Binding Caption, Converter={StaticResource HasText}}" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="{OnIdiom Phone='16,8,16,32', Default='28,12,28,32'}">
                <c:SegmentedControl x:Name="PeriodPicker" Margin="0,4,0,14"
                                    SelectedIndex="{Binding Period, Converter={StaticResource EnumIndex}}" />

                <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource Footnote}"
                       TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}"
                       Margin="2,0,2,10" />

                <FlexLayout BindableLayout.ItemsSource="{Binding Headline}" BindableLayout.ItemTemplate="{StaticResource MetricTile}"
                            Wrap="Wrap" Direction="Row" AlignItems="Start" Margin="0,0,-12,0" />
                <FlexLayout BindableLayout.ItemsSource="{Binding Secondary}" BindableLayout.ItemTemplate="{StaticResource MetricTile}"
                            Wrap="Wrap" Direction="Row" AlignItems="Start" Margin="0,0,-12,0" />

                <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Start" Margin="0,0,-12,0">
                    <Border Style="{StaticResource Card}" Margin="0,0,12,12" FlexLayout.Basis="460" FlexLayout.Grow="1">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Vehicles by hour" Style="{StaticResource Headline}" />
                            <c:ChartView Kind="Bars" Points="{Binding HourlyCaptures}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,12" FlexLayout.Basis="460" FlexLayout.Grow="1">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Entries and exits" Style="{StaticResource Headline}" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="12">
                                    <HorizontalStackLayout Spacing="5">
                                        <Ellipse WidthRequest="8" HeightRequest="8" VerticalOptions="Center"
                                                 Fill="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
                                        <Label Text="Entries" Style="{StaticResource Caption}" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="5">
                                        <Ellipse WidthRequest="8" HeightRequest="8" VerticalOptions="Center"
                                                 Fill="{AppThemeBinding Light={StaticResource CautionLight}, Dark={StaticResource CautionDark}}" />
                                        <Label Text="Exits" Style="{StaticResource Caption}" />
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>
                            </Grid>
                            <c:ChartView Kind="Lines" Points="{Binding HourlyEntries}" Secondary="{Binding HourlyExits}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,12" FlexLayout.Basis="300" FlexLayout.Grow="1">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Results" Style="{StaticResource Headline}" />
                            <c:ChartView Kind="Donut" Points="{Binding Verdicts}" HeightRequest="170" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Verdicts}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChartPoint">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <Ellipse WidthRequest="8" HeightRequest="8" VerticalOptions="Center"
                                                     Fill="{Binding Tone, Converter={StaticResource ToneColor}}" />
                                            <Label Grid.Column="1" Text="{Binding Label}" Style="{StaticResource Subhead}" />
                                            <Label Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Subhead}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,12" FlexLayout.Basis="300" FlexLayout.Grow="1">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Vehicle types" Style="{StaticResource Headline}" />
                            <c:ChartView Kind="HorizontalBars" Points="{Binding Classes}" HeightRequest="200" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,12" FlexLayout.Basis="300" FlexLayout.Grow="1">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Length of stay" Style="{StaticResource Headline}" />
                            <c:ChartView Kind="Bars" Points="{Binding Dwell}" HeightRequest="200" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,12" FlexLayout.Basis="300" FlexLayout.Grow="1" Padding="0,14,0,4">
                        <VerticalStackLayout>
                            <Label Text="Most frequent" Style="{StaticResource Headline}" Margin="16,0,16,6" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopPlates}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:TopPlate">
                                        <Grid Padding="16,9" ColumnDefinitions="*,Auto"
                                              m:Pressable.Command="{Binding Vm.ShowPlateCommand, Source={x:Reference Page}, x:DataType=p:DashboardPage}"
                                              m:Pressable.CommandParameter="{Binding .}">
                                            <VerticalStackLayout>
                                                <Label Text="{Binding Plate, Converter={StaticResource PlateText}}" Style="{StaticResource Plate}" FontSize="17" />
                                                <Label Text="{Binding LastSeen, Converter={StaticResource LocalTime}}" Style="{StaticResource Caption}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" VerticalOptions="Center" Style="{StaticResource Subhead}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Visits}" FontAttributes="Bold" />
                                                        <Span Text=" visits" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                                <BindableLayout.EmptyView>
                                    <Label Text="No vehicles in this period." Style="{StaticResource Subhead}" Padding="16,6,16,12" />
                                </BindableLayout.EmptyView>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </FlexLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</p:PageBase>

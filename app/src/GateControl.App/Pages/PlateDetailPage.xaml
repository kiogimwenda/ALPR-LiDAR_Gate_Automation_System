<?xml version="1.0" encoding="utf-8" ?>
<p:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:p="clr-namespace:GateControl.Pages"
            xmlns:vm="clr-namespace:GateControl.Core.ViewModels;assembly=GateControl.Core"
            xmlns:models="clr-namespace:GateControl.Core.Models;assembly=GateControl.Core"
            x:Class="GateControl.Pages.PlateDetailPage"
            x:DataType="vm:PlateDetailViewModel"
            Title="{Binding Plate}">
    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='16,8,16,32', Default='28,12,28,32'}">
            <!-- The plate, printed large -->
            <Border StrokeThickness="2" StrokeShape="RoundRectangle 10" Padding="18,8" HorizontalOptions="Start"
                    Stroke="{AppThemeBinding Light={StaticResource LabelLight}, Dark={StaticResource LabelDark}}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C1E}" Margin="0,8,0,6">
                <Label Text="{Binding Plate}" FontSize="34" FontAttributes="Bold" CharacterSpacing="2" />
            </Border>
            <Label Text="{Binding Registration}" Style="{StaticResource Subhead}" Margin="2,0,2,8"
                   IsVisible="{Binding Registration, Converter={StaticResource HasText}}" />
            <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource Footnote}"
                   TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Margin="0,12" />

            <FlexLayout BindableLayout.ItemsSource="{Binding Facts}" Wrap="Wrap" Direction="Row" Margin="0,8,-12,0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:Metric">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,12" FlexLayout.Basis="160" FlexLayout.Grow="1" Padding="14,12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Title}" Style="{StaticResource Footnote}" />
                                <Label Text="{Binding Value}" Style="{StaticResource Title3}" />
                                <Label Text="{Binding Caption}" Style="{StaticResource Caption}"
                                       IsVisible="{Binding Caption, Converter={StaticResource HasText}}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <Label Text="Visits" Style="{StaticResource SectionHeader}" Margin="2,10,2,6" />
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Visits}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:SessionRow">
                            <Grid Padding="16,10" ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Entered, Converter={StaticResource LocalTime}}" />
                                <Label Grid.Column="1" Text="{Binding DurationText}" Style="{StaticResource Subhead}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                    <BindableLayout.EmptyView>
                        <Label Text="Visits appear once entry and exit gates are set (Settings → Gates)."
                               Style="{StaticResource Subhead}" Padding="16,14" />
                    </BindableLayout.EmptyView>
                </VerticalStackLayout>
            </Border>

            <Label Text="History" Style="{StaticResource SectionHeader}" Margin="2,18,2,6" />
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding History}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:DecisionRow">
                            <Grid Padding="16,10" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <Label Text="{Binding When, Converter={StaticResource LocalTime}}" />
                                <Label Grid.Row="1" Style="{StaticResource Footnote}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Detail}" />
                                            <Span Text="  " />
                                            <Span Text="{Binding Reason}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Border Grid.Column="1" Grid.RowSpan="2" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="9,3"
                                        VerticalOptions="Center" BackgroundColor="{Binding Tone, Converter={StaticResource ToneTint}}">
                                    <Label Text="{Binding Verdict}" FontSize="13" FontAttributes="Bold"
                                           TextColor="{Binding Tone, Converter={StaticResource ToneColor}}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</p:PageBase>

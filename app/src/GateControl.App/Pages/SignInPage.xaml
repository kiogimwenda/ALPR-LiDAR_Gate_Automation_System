<?xml version="1.0" encoding="utf-8" ?>
<!-- Sign in — one centred card on the tinted canvas (spec §10): the brand
     mark, a 32/600 title, capsule fields in wells, an ink primary button.
     The card enters as A3, its fields as A4 rows. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:GateControl.Controls"
             xmlns:m="clr-namespace:GateControl.Motion"
             xmlns:vm="clr-namespace:GateControl.Core.ViewModels;assembly=GateControl.Core"
             x:Class="GateControl.Pages.SignInPage"
             x:DataType="vm:SignInViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource OuterLight}, Dark={StaticResource OuterDark}}">
    <ScrollView>
        <Grid RowDefinitions="*,Auto,*" Padding="16">
            <Border x:Name="Card" Grid.Row="1" Style="{StaticResource Card}" Padding="28" MaximumWidthRequest="440"
                    m:Reveal.Kind="Card" m:Reveal.Order="0">
                <VerticalStackLayout Spacing="0">
                    <Grid WidthRequest="44" HeightRequest="44" HorizontalOptions="Start">
                        <Border StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="{StaticResource BrandLight}"/>
                        <c:IconView Glyph="{x:Static c:Icons.DoorOpen}" Size="22" Tint="White" />
                    </Grid>
                    <Label Text="Gate Control" Style="{StaticResource LargeTitle}" Margin="0,18,0,4" />
                    <Label Text="Sign in to your site's gate server." Style="{StaticResource Subhead}" />

                    <Label Text="Server" Style="{StaticResource Footnote}" Margin="4,24,4,6" />
                    <Border Style="{StaticResource Inset}" StrokeShape="RoundRectangle 22" HeightRequest="44"
                            m:Reveal.Kind="Row" m:Reveal.Delay="0.12">
                        <Entry x:Name="ServerEntry" Text="{Binding Server}" Placeholder="192.168.1.50:8080"
                               Keyboard="Url" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                               ReturnType="Next" Completed="OnServerCompleted" VerticalOptions="Center"
                               SemanticProperties.Description="Gate server address" />
                    </Border>

                    <Label Text="Account" Style="{StaticResource Footnote}" Margin="4,18,4,6" />
                    <VerticalStackLayout Spacing="8" m:Reveal.Kind="Row" m:Reveal.Delay="0.185">
                        <Border Style="{StaticResource Inset}" StrokeShape="RoundRectangle 22" HeightRequest="44">
                            <Entry x:Name="UserEntry" Text="{Binding Username}" Placeholder="Username"
                                   IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" VerticalOptions="Center"
                                   ReturnType="Next" Completed="OnUserCompleted" />
                        </Border>
                        <Border Style="{StaticResource Inset}" StrokeShape="RoundRectangle 22" HeightRequest="44">
                            <Entry x:Name="PasswordEntry" Text="{Binding Password}" Placeholder="Password"
                                   IsPassword="True" ReturnType="Go" VerticalOptions="Center"
                                   ReturnCommand="{Binding SignInCommand}" />
                        </Border>
                    </VerticalStackLayout>
                    <Label Text="Leave the account empty if your server has no sign-in."
                           Style="{StaticResource Caption}" Margin="4,8,4,0" />

                    <Label Text="{Binding Error}" IsVisible="{Binding HasError}"
                           TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}"
                           FontSize="14" Margin="4,16,4,0" />

                    <Grid Margin="0,24,0,0" m:Reveal.Kind="Row" m:Reveal.Delay="0.25">
                        <Button Text="Sign In" Style="{StaticResource FilledButton}"
                                Command="{Binding SignInCommand}" IsVisible="{Binding IsIdle}" />
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="44" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>

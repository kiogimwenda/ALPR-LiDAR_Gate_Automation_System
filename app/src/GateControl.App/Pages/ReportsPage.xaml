<?xml version="1.0" encoding="utf-8" ?>
<p:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:p="clr-namespace:GateControl.Pages"
            xmlns:c="clr-namespace:GateControl.Controls"
            xmlns:m="clr-namespace:GateControl.Motion"
            xmlns:vm="clr-namespace:GateControl.Core.ViewModels;assembly=GateControl.Core"
            xmlns:models="clr-namespace:GateControl.Core.Models;assembly=GateControl.Core"
            x:Class="GateControl.Pages.ReportsPage"
            x:Name="Page"
            x:DataType="vm:ReportsViewModel">
    <ContentPage.Resources>
        <DataTemplate x:Key="DecisionRowTemplate" x:DataType="vm:DecisionRow">
            <Grid Padding="16,11" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                  m:Pressable.Command="{Binding Vm.ShowPlateCommand, Source={x:Reference Page}, x:DataType=p:ReportsPage}"
                  m:Pressable.CommandParameter="{Binding RawPlate}">
                <Label Text="{Binding Plate}" Style="{StaticResource Plate}" FontSize="17" />
                <Label Grid.Row="1" Text="{Binding Detail}" Style="{StaticResource Footnote}" LineBreakMode="TailTruncation" />
                <VerticalStackLayout Grid.Column="1" Grid.RowSpan="2" Spacing="3">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="9,3" HorizontalOptions="End"
                            BackgroundColor="{Binding Tone, Converter={StaticResource ToneTint}}">
                        <Label Text="{Binding Verdict}" FontSize="13" FontAttributes="Bold"
                               TextColor="{Binding Tone, Converter={StaticResource ToneColor}}" />
                    </Border>
                    <Label Text="{Binding When, Converter={StaticResource LocalTime}}" Style="{StaticResource Caption}" HorizontalOptions="End" />
                </VerticalStackLayout>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SessionRowTemplate" x:DataType="models:SessionRow">
            <Grid Padding="16,10" ColumnDefinitions="*,Auto"
                  m:Pressable.Command="{Binding Vm.ShowPlateCommand, Source={x:Reference Page}, x:DataType=p:ReportsPage}"
                  m:Pressable.CommandParameter="{Binding Plate}">
                <VerticalStackLayout>
                    <Label Text="{Binding Plate, Converter={StaticResource PlateText}}" Style="{StaticResource Plate}" FontSize="17" />
                    <Label Text="{Binding Entered, Converter={StaticResource LocalTime}}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
                <Label Grid.Column="1" VerticalOptions="Center" Style="{StaticResource Subhead}"
                       Text="{Binding DurationText}" FontAttributes="Bold" />
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,32" MaximumWidthRequest="1100">
            <c:SegmentedControl x:Name="KindPicker" Margin="0,4,0,12"
                                SelectedIndex="{Binding Kind, Converter={StaticResource EnumIndex}}" />

            <!-- Date range, shared by every report -->
            <Border Style="{StaticResource Card}" Padding="16,4">
                <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                    <Label Text="From" VerticalOptions="Center" Style="{StaticResource Subhead}" />
                    <DatePicker Grid.Column="1" Date="{Binding FromDate}" Format="d MMM yyyy" DateSelected="OnDateChanged" />
                    <Label Grid.Column="2" Text="to" VerticalOptions="Center" Style="{StaticResource Subhead}" />
                    <DatePicker Grid.Column="3" Date="{Binding ToDate}" Format="d MMM yyyy" DateSelected="OnDateChanged" />
                </Grid>
            </Border>

            <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource Footnote}"
                   TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}"
                   Margin="2,10,2,0" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Margin="0,12" />

            <!-- ============ Search ============ -->
            <VerticalStackLayout IsVisible="{Binding Kind, Converter={StaticResource Is}, ConverterParameter=Search}">
                <Label Text="Filters" Style="{StaticResource SectionHeader}" Margin="2,18,2,6" />
                <Border Style="{StaticResource Card}" Padding="16,2">
                    <VerticalStackLayout>
                        <Entry Text="{Binding Plate}" Placeholder="Plate (any part, e.g. KDA 12)" ReturnType="Search"
                               ReturnCommand="{Binding SearchCommand}" IsSpellCheckEnabled="False" />
                        <BoxView Style="{StaticResource Separator}" />
                        <Picker ItemsSource="{x:Static vm:ReportsViewModel.Verdicts}" ItemDisplayBinding="{Binding Label, x:DataType=vm:Choice}"
                                SelectedItem="{Binding Verdict}" Title="Result" />
                        <BoxView Style="{StaticResource Separator}" />
                        <Picker ItemsSource="{x:Static vm:ReportsViewModel.Classes}" ItemDisplayBinding="{Binding Label, x:DataType=vm:Choice}"
                                SelectedItem="{Binding VehicleClass}" Title="Vehicle" />
                        <BoxView Style="{StaticResource Separator}" />
                        <Picker ItemsSource="{x:Static vm:ReportsViewModel.Directions}" ItemDisplayBinding="{Binding Label, x:DataType=vm:Choice}"
                                SelectedItem="{Binding Direction}" Title="Direction" />
                        <BoxView Style="{StaticResource Separator}" />
                        <Picker ItemsSource="{Binding Gates}" ItemDisplayBinding="{Binding Label, x:DataType=vm:Choice}"
                                SelectedItem="{Binding Gate}" Title="Gate" />
                        <BoxView Style="{StaticResource Separator}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" MinimumHeightRequest="44">
                            <Label Text="Min. confidence" VerticalOptions="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding MinConfidence}" VerticalOptions="Center" />
                            <Label Grid.Column="2" x:Name="ConfidenceLabel" VerticalOptions="Center" Style="{StaticResource Subhead}" WidthRequest="44" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,12,0,0">
                    <Button Text="Search" Style="{StaticResource FilledButton}" HeightRequest="44" Command="{Binding SearchCommand}" />
                    <Button Grid.Column="1" Text="Clear" Style="{StaticResource TintedButton}" HeightRequest="44" Command="{Binding ClearFiltersCommand}" />
                    <Button Grid.Column="2" Text="Export CSV" Style="{StaticResource TintedButton}" HeightRequest="44" Command="{Binding ExportCommand}" />
                </Grid>

                <Label Text="{Binding ResultCaption}" Style="{StaticResource SectionHeader}" Margin="2,20,2,6" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Results}"
                                         BindableLayout.ItemTemplate="{StaticResource DecisionRowTemplate}" />
                </Border>
                <Button Text="Show more" Style="{StaticResource PlainButton}" Command="{Binding LoadMoreCommand}"
                        IsVisible="{Binding CanLoadMore}" Margin="0,8,0,0" />
            </VerticalStackLayout>

            <!-- ============ Visits ============ -->
            <VerticalStackLayout IsVisible="{Binding Kind, Converter={StaticResource Is}, ConverterParameter=Visits}">
                <Label Text="{Binding VisitsSummary}" Style="{StaticResource Subhead}" Margin="2,16,2,8" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Length of stay" Style="{StaticResource Headline}" />
                        <c:ChartView Kind="Bars" Points="{Binding DwellChart}" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="On site now" Style="{StaticResource SectionHeader}" Margin="2,18,2,6" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding OnSite}"
                                         BindableLayout.ItemTemplate="{StaticResource SessionRowTemplate}">
                        <BindableLayout.EmptyView>
                            <Label Text="Nobody is on site." Style="{StaticResource Subhead}" Padding="16,14" />
                        </BindableLayout.EmptyView>
                    </VerticalStackLayout>
                </Border>
                <Label Text="Longest visits" Style="{StaticResource SectionHeader}" Margin="2,18,2,6" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Longest}"
                                         BindableLayout.ItemTemplate="{StaticResource SessionRowTemplate}" />
                </Border>
            </VerticalStackLayout>

            <!-- ============ Unreadable ============ -->
            <VerticalStackLayout IsVisible="{Binding Kind, Converter={StaticResource Is}, ConverterParameter=Unreadable}">
                <Label Style="{StaticResource Subhead}" Margin="2,16,2,8"
                       Text="Frames the system could not act on — no plate, or a read too unclear to trust." />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Why" Style="{StaticResource Headline}" />
                        <c:ChartView Kind="HorizontalBars" Points="{Binding UnreadableReasons}" HeightRequest="120" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="Recent" Style="{StaticResource SectionHeader}" Margin="2,18,2,6" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Unreadable}"
                                         BindableLayout.ItemTemplate="{StaticResource DecisionRowTemplate}" />
                </Border>
            </VerticalStackLayout>

            <!-- ============ Trend ============ -->
            <VerticalStackLayout IsVisible="{Binding Kind, Converter={StaticResource Is}, ConverterParameter=Trend}" Spacing="12" Margin="0,16,0,0">
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Vehicles per day" Style="{StaticResource Headline}" />
                        <c:ChartView Kind="Bars" Points="{Binding TrendVehicles}" HeightRequest="200" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Refused per day" Style="{StaticResource Headline}" />
                        <c:ChartView Kind="Bars" Points="{Binding TrendRefused}" HeightRequest="160" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</p:PageBase>

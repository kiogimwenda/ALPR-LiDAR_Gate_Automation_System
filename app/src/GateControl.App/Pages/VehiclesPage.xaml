<?xml version="1.0" encoding="utf-8" ?>
<p:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:p="clr-namespace:GateControl.Pages"
            xmlns:c="clr-namespace:GateControl.Controls"
            xmlns:m="clr-namespace:GateControl.Motion"
            xmlns:vm="clr-namespace:GateControl.Core.ViewModels;assembly=GateControl.Core"
            x:Class="GateControl.Pages.VehiclesPage"
            x:Name="Page"
            x:DataType="vm:AllowlistViewModel">
    <Grid>
        <!-- Vehicles — the reference's "Manage" pattern (spec §10): title with
             the primary action at the right, a search well, and the registered
             vehicles as control rows in one card. Swipe to remove; add / edit
             in the sheet. -->
        <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
            <ScrollView>
                <VerticalStackLayout Padding="{OnIdiom Phone='4,4,4,32', Default='8,4,8,32'}" Spacing="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <c:TitleLabel Text="Vehicles" />
                            <Label Text="Registered vehicles the gates let in, with their owners and limits."
                                   Style="{StaticResource Subhead}" m:Reveal.Kind="Row" m:Reveal.Delay="0.1" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="+  Add vehicle" Style="{StaticResource FilledButton}" HeightRequest="40"
                                VerticalOptions="Center" Command="{Binding AddCommand}" IsVisible="{Binding CanEdit}"
                                m:Reveal.Kind="Row" m:Reveal.Delay="0.15" />
                    </Grid>

                    <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource Footnote}"
                           TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                    <Label Text="Managing registered vehicles needs the operator role." Style="{StaticResource Subhead}"
                           IsVisible="{Binding CanEdit, Converter={StaticResource Not}}" />

                    <Border Style="{StaticResource Card}" Padding="0,14,0,6" m:Reveal.Kind="Card" m:Reveal.Order="0"
                            IsVisible="{Binding CanEdit}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" Padding="16,0">
                                <Label Text="Registered" Style="{StaticResource Headline}" VerticalOptions="Center" />
                                <Border Grid.Column="1" Style="{StaticResource Chip}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource WellLight}, Dark={StaticResource WellDark}}">
                                    <Label Text="{Binding CountText}" FontFamily="InterSemiBold" FontSize="12" />
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource Inset}" HeightRequest="40" Margin="16,0" StrokeShape="RoundRectangle 20">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <c:IconView Glyph="{x:Static c:Icons.Search}" Size="15" />
                                    <Entry Grid.Column="1" Text="{Binding Query}" Placeholder="Search plate, owner or unit"
                                           IsSpellCheckEnabled="False" ReturnType="Search" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <VerticalStackLayout m:Reveal.Items="True" BindableLayout.ItemsSource="{Binding Items}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AllowlistRow">
                                        <SwipeView>
                                            <SwipeView.RightItems>
                                                <SwipeItems Mode="Execute">
                                                    <SwipeItem Text="Remove" BackgroundColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}"
                                                               Command="{Binding Vm.RemoveCommand, Source={x:Reference Page}, x:DataType=p:VehiclesPage}"
                                                               CommandParameter="{Binding .}" />
                                                </SwipeItems>
                                            </SwipeView.RightItems>
                                            <Grid Padding="16,9" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                                                  BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                                  m:Pressable.Command="{Binding Vm.EditCommand, Source={x:Reference Page}, x:DataType=p:VehiclesPage}"
                                                  m:Pressable.CommandParameter="{Binding .}">
                                                <Grid WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                                                    <Border StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="{AppThemeBinding Light={StaticResource WellLight}, Dark={StaticResource WellDark}}"/>
                                                    <c:IconView Glyph="{x:Static c:IconsExtra.Vehicle}" Size="16" />
                                                </Grid>
                                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                                    <Label Text="{Binding Plate}" Style="{StaticResource Plate}" FontSize="15" />
                                                    <Label Text="{Binding Owner}" Style="{StaticResource Subhead}"
                                                           IsVisible="{Binding Owner, Converter={StaticResource HasText}}" />
                                                    <Label Text="{Binding Classes}" Style="{StaticResource Caption}" />
                                                </VerticalStackLayout>
                                                <Border Grid.Column="2" Style="{StaticResource Chip}" VerticalOptions="Center" IsVisible="{Binding HasRestriction}"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource BrandTintLight}, Dark={StaticResource BrandTintDark}}">
                                                    <Label Text="{Binding Restricted}" FontFamily="InterSemiBold" FontSize="12"
                                                           TextColor="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
                                                </Border>
                                            </Grid>
                                        </SwipeView>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                                <BindableLayout.EmptyView>
                                    <Label Text="No registered vehicles match." Style="{StaticResource Subhead}" Padding="16,8,16,12" />
                                </BindableLayout.EmptyView>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Label Text="Swipe left on a vehicle to remove it." Style="{StaticResource Footnote}"
                           IsVisible="{Binding CanEdit}" Margin="4,0" m:Reveal.Kind="Row" m:Reveal.Order="4" />
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Add / edit: an iOS sheet (drag down to dismiss). -->
        <c:Sheet x:Name="EditorSheet" IsOpen="{Binding Editor, Converter={StaticResource NotNull}, Mode=OneWay}"
                 DismissCommand="{Binding Editor.CancelCommand, FallbackValue={x:Null}}">
            <c:Sheet.SheetContent>
                <ScrollView x:DataType="vm:AllowlistViewModel">
                    <VerticalStackLayout x:Name="EditorForm" Padding="16,0,16,16" x:DataType="vm:PlateEditorViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Text="Cancel" Style="{StaticResource PlainButton}" Command="{Binding CancelCommand}" />
                            <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Headline}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <Button Grid.Column="2" Text="Save" Style="{StaticResource PlainButton}" FontAttributes="Bold"
                                    Command="{Binding SaveCommand}" />
                        </Grid>
                        <Label Text="Vehicle" Style="{StaticResource SectionHeader}" Margin="4,16,4,6" />
                        <Border Style="{StaticResource SheetCard}" Padding="16,2">
                            <VerticalStackLayout>
                                <Entry Text="{Binding Plate}" Placeholder="Plate, e.g. KDA 123A" IsEnabled="{Binding IsNew}"
                                       IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" FontAttributes="Bold" />
                                <BoxView Style="{StaticResource Separator}" />
                                <Entry Text="{Binding OwnerName}" Placeholder="Owner" />
                                <BoxView Style="{StaticResource Separator}" />
                                <Entry Text="{Binding OwnerUnit}" Placeholder="House / unit" />
                                <BoxView Style="{StaticResource Separator}" />
                                <Entry Text="{Binding Notes}" Placeholder="Notes" />
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="Allowed vehicle types" Style="{StaticResource SectionHeader}" Margin="4,18,4,6" />
                        <Border Style="{StaticResource SheetCard}" Padding="16,4">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Classes}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ClassToggle">
                                        <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="44">
                                            <Label Text="{Binding Label}" VerticalOptions="Center" />
                                            <Switch Grid.Column="1" IsToggled="{Binding Selected}" VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Border>
                        <Label Text="Leave all off to allow any vehicle. When types are set and the LiDAR sees a different one, the gate holds the vehicle for review."
                               Style="{StaticResource Footnote}" Margin="4,8,4,0" />

                        <Label Text="Access" Style="{StaticResource SectionHeader}" Margin="4,18,4,6" />
                        <Border Style="{StaticResource SheetCard}" Padding="16,4">
                            <VerticalStackLayout>
                                <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="44">
                                    <Label Text="Expires" VerticalOptions="Center" />
                                    <Switch Grid.Column="1" IsToggled="{Binding HasExpiry}" VerticalOptions="Center" />
                                </Grid>
                                <DatePicker Date="{Binding Expires}" IsVisible="{Binding HasExpiry}" Format="d MMMM yyyy" />
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource Footnote}" Margin="4,12,4,0"
                               TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                    </VerticalStackLayout>
                </ScrollView>
            </c:Sheet.SheetContent>
        </c:Sheet>
    </Grid>
</p:PageBase>

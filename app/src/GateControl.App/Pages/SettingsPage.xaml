<?xml version="1.0" encoding="utf-8" ?>
<!-- Account and settings — the reference's "Card controls" pattern (spec
     §10): the profile card, appearance as a mini segmented control (the
     wipe plays from the shell's sun / moon buttons), admin links as control
     rows with round icons, password change, sign out. -->
<p:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:c="clr-namespace:GateControl.Controls"
            xmlns:p="clr-namespace:GateControl.Pages"
            xmlns:m="clr-namespace:GateControl.Motion"
            xmlns:vm="clr-namespace:GateControl.Core.ViewModels;assembly=GateControl.Core"
            x:Class="GateControl.Pages.SettingsPage"
            x:DataType="vm:SettingsViewModel"
            Title="Account"
            x:Name="Page">
    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='16,8,16,40', Default='28,12,28,40'}" Spacing="16" MaximumWidthRequest="760">
            <VerticalStackLayout Spacing="4">
                <c:TitleLabel Text="Account" />
                <Label Text="Your profile, appearance and the site's settings." Style="{StaticResource Subhead}"
                       m:Reveal.Kind="Row" m:Reveal.Delay="0.1" />
            </VerticalStackLayout>

            <!-- Who's signed in -->
            <Border Style="{StaticResource Card}" m:Reveal.Kind="Card" m:Reveal.Order="0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border WidthRequest="56" HeightRequest="56" StrokeThickness="0" StrokeShape="Ellipse"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}">
                        <Label Text="{Binding Initials}" TextColor="{AppThemeBinding Light={StaticResource OnInkLight}, Dark={StaticResource OnInkDark}}"
                               FontFamily="InterSemiBold" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="{Binding DisplayName}" Style="{StaticResource Title3}" />
                        <Label Text="{Binding RoleText}" Style="{StaticResource Subhead}" />
                        <Label Text="{Binding Server}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" m:Reveal.Kind="Card" m:Reveal.Order="1">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Appearance" Style="{StaticResource Headline}" />
                    <c:SegmentedControl x:Name="AppearancePicker" SelectedIndex="{Binding AppearanceChoice, Converter={StaticResource EnumIndex}}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0,14,0,6" IsVisible="{Binding IsAdmin}" m:Reveal.Kind="Card" m:Reveal.Order="2">
                <VerticalStackLayout>
                    <Label Text="Site" Style="{StaticResource Headline}" Margin="16,0,16,6" />
                    <Grid Padding="16,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                          m:Pressable.Command="{Binding Source={x:Reference Page}, Path=OpenUsersCommand, x:DataType=p:SettingsPage}">
                        <Grid WidthRequest="36" HeightRequest="36">
                            <Border StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="{AppThemeBinding Light={StaticResource WellLight}, Dark={StaticResource WellDark}}"/>
                            <c:IconView Glyph="{x:Static c:Icons.Users}" Size="16" />
                        </Grid>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Users and roles" Style="{StaticResource Callout}" />
                            <Label Text="Who can sign in, and what they can do" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <c:IconView Grid.Column="2" Glyph="{x:Static c:Icons.ChevronDown}" Size="14" Rotation="-90" />
                    </Grid>
                    <Grid Padding="16,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                          m:Pressable.Command="{Binding Source={x:Reference Page}, Path=OpenGatesCommand, x:DataType=p:SettingsPage}">
                        <Grid WidthRequest="36" HeightRequest="36">
                            <Border StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="{AppThemeBinding Light={StaticResource WellLight}, Dark={StaticResource WellDark}}"/>
                            <c:IconView Glyph="{x:Static c:Icons.DoorOpen}" Size="16" />
                        </Grid>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Gates" Style="{StaticResource Callout}" />
                            <Label Text="Names, locations, entry and exit" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <c:IconView Grid.Column="2" Glyph="{x:Static c:Icons.ChevronDown}" Size="14" Rotation="-90" />
                    </Grid>
                    <Grid Padding="16,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                          m:Pressable.Command="{Binding Source={x:Reference Page}, Path=OpenDataCommand, x:DataType=p:SettingsPage}">
                        <Grid WidthRequest="36" HeightRequest="36">
                            <Border StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="{AppThemeBinding Light={StaticResource WellLight}, Dark={StaticResource WellDark}}"/>
                            <c:IconView Glyph="{x:Static c:Icons.Database}" Size="16" />
                        </Grid>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Data and retention" Style="{StaticResource Callout}" />
                            <Label Text="How long history is kept" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                        <c:IconView Grid.Column="2" Glyph="{x:Static c:Icons.ChevronDown}" Size="14" Rotation="-90" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" IsVisible="{Binding AuthRequired}" m:Reveal.Kind="Card" m:Reveal.Order="3">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Change password" Style="{StaticResource Headline}" />
                    <Border Style="{StaticResource Inset}" StrokeShape="RoundRectangle 20" HeightRequest="44">
                        <Entry Text="{Binding CurrentPassword}" Placeholder="Current password" IsPassword="True" VerticalOptions="Center" />
                    </Border>
                    <Border Style="{StaticResource Inset}" StrokeShape="RoundRectangle 20" HeightRequest="44">
                        <Entry Text="{Binding NewPassword}" Placeholder="New password (10+ characters)" IsPassword="True" VerticalOptions="Center" />
                    </Border>
                    <Border Style="{StaticResource Inset}" StrokeShape="RoundRectangle 20" HeightRequest="44">
                        <Entry Text="{Binding ConfirmPassword}" Placeholder="Repeat new password" IsPassword="True" VerticalOptions="Center" />
                    </Border>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding PasswordMessage}" Style="{StaticResource Footnote}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Change" Style="{StaticResource FilledButton}" HeightRequest="40"
                                Command="{Binding ChangePasswordCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Sign out" Style="{StaticResource DestructiveButton}" HeightRequest="44"
                    Command="{Binding SignOutCommand}" IsVisible="{Binding AuthRequired}"
                    m:Reveal.Kind="Row" m:Reveal.Order="8" />
            <Label x:Name="VersionLabel" Style="{StaticResource Caption}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</p:PageBase>

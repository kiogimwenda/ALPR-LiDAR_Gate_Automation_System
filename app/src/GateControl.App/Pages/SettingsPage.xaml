<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:GateControl.Controls"
             xmlns:p="clr-namespace:GateControl.Pages"
             xmlns:m="clr-namespace:GateControl.Motion"
             xmlns:vm="clr-namespace:GateControl.Core.ViewModels;assembly=GateControl.Core"
             x:Class="GateControl.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings"
             x:Name="Page">
    <ContentPage.Resources>
        <Style x:Key="RowLabel" TargetType="Label">
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='16,8,16,40', Default='28,12,28,40'}">
            <!-- Who's signed in -->
            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border WidthRequest="56" HeightRequest="56" StrokeThickness="0" StrokeShape="Ellipse"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}">
                        <Label Text="{Binding Initials}" TextColor="White" FontSize="22" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="{Binding DisplayName}" Style="{StaticResource Title3}" />
                        <Label Text="{Binding RoleText}" Style="{StaticResource Subhead}" />
                        <Label Text="{Binding Server}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Label Text="Appearance" Style="{StaticResource SectionHeader}" />
            <c:SegmentedControl x:Name="AppearancePicker"
                                SelectedIndex="{Binding AppearanceChoice, Converter={StaticResource EnumIndex}}" />

            <VerticalStackLayout IsVisible="{Binding IsAdmin}">
                <Label Text="Site" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout>
                        <Grid Padding="16,0" HeightRequest="48" ColumnDefinitions="*,Auto"
                              m:Pressable.Command="{Binding Source={x:Reference Page}, Path=OpenUsersCommand, x:DataType=p:SettingsPage}">
                            <Label Text="Users and roles" Style="{StaticResource RowLabel}" />
                            <Label Grid.Column="1" Text="›" FontSize="22" Style="{StaticResource Subhead}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource Separator}" Margin="16,0,0,0" />
                        <Grid Padding="16,0" HeightRequest="48" ColumnDefinitions="*,Auto"
                              m:Pressable.Command="{Binding Source={x:Reference Page}, Path=OpenGatesCommand, x:DataType=p:SettingsPage}">
                            <Label Text="Gates" Style="{StaticResource RowLabel}" />
                            <Label Grid.Column="1" Text="›" FontSize="22" Style="{StaticResource Subhead}" VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource Separator}" Margin="16,0,0,0" />
                        <Grid Padding="16,0" HeightRequest="48" ColumnDefinitions="*,Auto"
                              m:Pressable.Command="{Binding Source={x:Reference Page}, Path=OpenDataCommand, x:DataType=p:SettingsPage}">
                            <Label Text="Data and retention" Style="{StaticResource RowLabel}" />
                            <Label Grid.Column="1" Text="›" FontSize="22" Style="{StaticResource Subhead}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding AuthRequired}">
                <Label Text="Change password" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource Card}" Padding="16,2">
                    <VerticalStackLayout>
                        <Entry Text="{Binding CurrentPassword}" Placeholder="Current password" IsPassword="True" />
                        <BoxView Style="{StaticResource Separator}" />
                        <Entry Text="{Binding NewPassword}" Placeholder="New password (10+ characters)" IsPassword="True" />
                        <BoxView Style="{StaticResource Separator}" />
                        <Entry Text="{Binding ConfirmPassword}" Placeholder="Repeat new password" IsPassword="True" />
                    </VerticalStackLayout>
                </Border>
                <Grid ColumnDefinitions="*,Auto" Margin="4,8,0,0">
                    <Label Text="{Binding PasswordMessage}" Style="{StaticResource Footnote}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Change" Style="{StaticResource TintedButton}" HeightRequest="36"
                            Command="{Binding ChangePasswordCommand}" />
                </Grid>
            </VerticalStackLayout>

            <Button Text="Sign Out" Style="{StaticResource DestructiveButton}" HeightRequest="48" Margin="0,32,0,0"
                    Command="{Binding SignOutCommand}" IsVisible="{Binding AuthRequired}" />
            <Label x:Name="VersionLabel" Style="{StaticResource Caption}" HorizontalOptions="Center" Margin="0,20,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

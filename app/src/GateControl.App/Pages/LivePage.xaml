<?xml version="1.0" encoding="utf-8" ?>
<!-- Live — the reference's "Rewards Program" pattern (spec §10): a hero
     accent card with today's tally, the gates as control cards, and the
     vehicle feed as a history list. -->
<p:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:p="clr-namespace:GateControl.Pages"
            xmlns:c="clr-namespace:GateControl.Controls"
            xmlns:m="clr-namespace:GateControl.Motion"
            xmlns:vm="clr-namespace:GateControl.Core.ViewModels;assembly=GateControl.Core"
            x:Class="GateControl.Pages.LivePage"
            x:Name="Page"
            x:DataType="vm:LiveViewModel">
    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="{OnIdiom Phone='4,4,4,32', Default='8,4,8,32'}" Spacing="16">

                <VerticalStackLayout Spacing="4">
                    <c:TitleLabel Text="Live" />
                    <Label Text="Gates, commands and every plate as it is read." Style="{StaticResource Subhead}"
                           m:Reveal.Kind="Row" m:Reveal.Delay="0.1" />
                </VerticalStackLayout>

                <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource Footnote}"
                       TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />

                <!-- Hero: today's tally on the accent card (A6 blob reveal, A5 count-up) -->
                <Grid>
                <Image x:Name="HeroGlow" Source="accent_glow.png" Aspect="Fill" WidthRequest="0" HeightRequest="0"
                       HorizontalOptions="Center" VerticalOptions="Center" TranslationY="10" InputTransparent="True" />
                <Border Style="{StaticResource AccentCard}" m:Reveal.Kind="Accent" m:Reveal.Order="0" m:Reveal.Glow="{x:Reference HeroGlow}" x:Name="HeroCard" SizeChanged="OnAccentSized">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border x:Name="FeedPill" StrokeThickness="0" StrokeShape="RoundRectangle 11" Padding="10,3"
                                    BackgroundColor="#33FFFFFF">
                                <HorizontalStackLayout Spacing="6">
                                    <Border StrokeThickness="0" StrokeShape="Ellipse" x:Name="FeedDot" WidthRequest="8" HeightRequest="8" VerticalOptions="Center"/>
                                    <Label Text="{Binding FeedStateText}" FontFamily="InterSemiBold" FontSize="12" TextColor="White" />
                                </HorizontalStackLayout>
                            </Border>
                            <Label Grid.Column="1" Text="Today" HorizontalOptions="End" VerticalOptions="Center"
                                   FontSize="12" TextColor="#CCFFFFFF" />
                        </Grid>
                        <HorizontalStackLayout Grid.Row="1" Spacing="8">
                            <Label m:CountUp.Key="live:allowed" m:CountUp.Text="{Binding TodayAllowed, StringFormat='{0:N0}'}"
                                   Style="{StaticResource HeroNumber}" />
                            <Label Text="allowed" FontFamily="InterMedium" FontSize="16" TextColor="#E6FFFFFF"
                                   VerticalOptions="End" Margin="0,0,0,12" />
                        </HorizontalStackLayout>
                        <!-- Share of reads allowed: a white bar on a translucent track (ScaleX, never layout). -->
                        <Grid Grid.Row="2" HeightRequest="6">
                            <BoxView Color="#40FFFFFF" CornerRadius="3" />
                            <BoxView Color="White" CornerRadius="3" AnchorX="0" ScaleX="{Binding AllowedShare}" />
                        </Grid>
                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                            <Label FontSize="13" TextColor="#E6FFFFFF" VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding TodayDenied, StringFormat='{0:N0}'}" FontFamily="InterSemiBold" />
                                        <Span Text=" refused · " />
                                        <Span Text="{Binding TodayTotal, StringFormat='{0:N0}'}" FontFamily="InterSemiBold" />
                                        <Span Text=" reads" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>
                    </Grid>
                </Border>
                </Grid>

                <!-- Gates as control cards -->
                <Label Text="Gates" Style="{StaticResource SectionHeader}" Margin="4,4,4,-6"
                       m:Reveal.Kind="Row" m:Reveal.Delay="0.12" />
                <c:TileGrid m:Reveal.Items="True" BindableLayout.ItemsSource="{Binding Gates}" MinTileWidth="320" Spacing="16"
                            m:Reveal.Kind="Card" m:Reveal.Order="1">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:GateTileViewModel">
                            <Border Style="{StaticResource Card}" m:HoverLift.Enabled="True">
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Name}" Style="{StaticResource Title3}" LineBreakMode="TailTruncation" />
                                        <Border Grid.Column="1" Style="{StaticResource Chip}" VerticalOptions="Center"
                                                BackgroundColor="{Binding StateTone, Converter={StaticResource ToneTint}}">
                                            <Label Text="{Binding StateText}" FontFamily="InterSemiBold" FontSize="12"
                                                   TextColor="{Binding StateTone, Converter={StaticResource ToneColor}}" />
                                        </Border>
                                    </Grid>
                                    <!-- control rows (Manage "Card controls") -->
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                        <Grid WidthRequest="32" HeightRequest="32">
                                            <Border StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="{AppThemeBinding Light={StaticResource WellLight}, Dark={StaticResource WellDark}}"/>
                                            <c:IconView Glyph="{x:Static c:Icons.DoorOpen}" Size="15" />
                                        </Grid>
                                        <Label Grid.Column="1" Text="{Binding DirectionText}" Style="{StaticResource Callout}" VerticalOptions="Center" />
                                        <Grid Grid.Row="1" WidthRequest="32" HeightRequest="32">
                                            <Border StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="{AppThemeBinding Light={StaticResource WellLight}, Dark={StaticResource WellDark}}"/>
                                            <c:IconView Glyph="{x:Static c:IconsExtra.Pulse}" Size="15" />
                                        </Grid>
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding BeamText}" Style="{StaticResource Callout}" VerticalOptions="Center" />
                                        <Grid Grid.Row="2" WidthRequest="32" HeightRequest="32">
                                            <Border StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="{AppThemeBinding Light={StaticResource WellLight}, Dark={StaticResource WellDark}}"/>
                                            <c:IconView Glyph="{x:Static c:IconsExtra.Vehicle}" Size="15" />
                                        </Grid>
                                        <VerticalStackLayout Grid.Row="2" Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding LastActivity}" Style="{StaticResource Callout}" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                   IsVisible="{Binding Detail, Converter={StaticResource HasText}}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8"
                                          IsVisible="{Binding Vm.CanOperate, Source={x:Reference Page}, x:DataType=p:LivePage}">
                                        <Button Text="Open" Style="{StaticResource FilledButton}" HeightRequest="40" Command="{Binding OpenCommand}" />
                                        <Button Grid.Column="1" Text="Close" Style="{StaticResource TintedButton}" Command="{Binding CloseCommand}" />
                                        <Button Grid.Column="2" Text="•••" Style="{StaticResource TintedButton}" WidthRequest="52"
                                                Clicked="OnMoreClicked" CommandParameter="{Binding .}"
                                                SemanticProperties.Description="More gate controls" />
                                    </Grid>
                                    <Label Text="{Binding CommandStatus}" Style="{StaticResource Caption}"
                                           IsVisible="{Binding CommandStatus, Converter={StaticResource HasText}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding CommandFailed}" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                                                <Setter Property="FontFamily" Value="InterSemiBold" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                    <BindableLayout.EmptyView>
                        <Label Text="No gates have reported yet." Style="{StaticResource Subhead}" Margin="4,0" />
                    </BindableLayout.EmptyView>
                </c:TileGrid>

                <!-- The feed as a history list (Points history) -->
                <Border Style="{StaticResource Card}" Padding="0,14,0,6" m:Reveal.Kind="Card" m:Reveal.Order="2">
                    <VerticalStackLayout>
                        <Label Text="Latest vehicles" Style="{StaticResource Headline}" Margin="16,0,16,6" />
                        <VerticalStackLayout x:Name="FeedList" BindableLayout.ItemsSource="{Binding Feed}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:DecisionRow">
                                    <Grid Padding="16,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                                          m:Pressable.Command="{Binding Vm.ShowPlateCommand, Source={x:Reference Page}, x:DataType=p:LivePage}"
                                          m:Pressable.CommandParameter="{Binding .}">
                                        <Grid WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                                            <Border StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="{Binding Tone, Converter={StaticResource ToneTint}}"/>
                                            <c:IconView Glyph="{x:Static c:IconsExtra.Vehicle}" Size="16" />
                                        </Grid>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Plate}" Style="{StaticResource Plate}" FontSize="15" />
                                            <Label Text="{Binding Detail}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                            <Border Style="{StaticResource Chip}" HorizontalOptions="End"
                                                    BackgroundColor="{Binding Tone, Converter={StaticResource ToneTint}}">
                                                <Label Text="{Binding Verdict}" FontFamily="InterSemiBold" FontSize="12"
                                                       TextColor="{Binding Tone, Converter={StaticResource ToneColor}}" />
                                            </Border>
                                            <Label Text="{Binding TimeText}" Style="{StaticResource Caption}" HorizontalOptions="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                            <BindableLayout.EmptyView>
                                <Label Text="Vehicles appear here the moment a plate is read." Style="{StaticResource Subhead}"
                                       Padding="16,8,16,12" />
                            </BindableLayout.EmptyView>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</p:PageBase>

<?xml version="1.0" encoding="utf-8" ?>
<p:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:p="clr-namespace:GateControl.Pages"
            xmlns:c="clr-namespace:GateControl.Controls"
            xmlns:m="clr-namespace:GateControl.Motion"
            xmlns:vm="clr-namespace:GateControl.Core.ViewModels;assembly=GateControl.Core"
            x:Class="GateControl.Pages.GatesPage"
            x:Name="Page"
            x:DataType="vm:GatesViewModel"
            Title="">
    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='16,8,16,32', Default='28,12,28,32'}" Spacing="0">
            <VerticalStackLayout Spacing="4">
                <c:TitleLabel Text="Gates" />
                <Label Style="{StaticResource Subhead}" m:Reveal.Kind="Row" m:Reveal.Delay="0.1"
                       Text="Name each gate and say which way it lets vehicles through. Visits, dwell time and who is on site need an entry gate and an exit gate." />
            </VerticalStackLayout>
            <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource Footnote}" Margin="4,8"
                   TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" m:Reveal.Kind="Card" m:Reveal.Order="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:GateConfigRow">
                        <VerticalStackLayout>
                            <Border Style="{StaticResource Card}" Padding="16,14,16,6" Margin="0,16,0,0">
                                <VerticalStackLayout>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="0,0,0,6">
                                        <Grid WidthRequest="36" HeightRequest="36">
                                            <Border StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="{AppThemeBinding Light={StaticResource WellLight}, Dark={StaticResource WellDark}}"/>
                                            <c:IconView Glyph="{x:Static c:Icons.DoorOpen}" Size="16" />
                                        </Grid>
                                        <Label Grid.Column="1" Text="{Binding GateId}" Style="{StaticResource Headline}" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding Status}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                    </Grid>
                                    <Entry Text="{Binding Name}" Placeholder="Name, e.g. Main entrance" />
                                    <BoxView Style="{StaticResource Separator}" />
                                    <Entry Text="{Binding Location}" Placeholder="Location" />
                                    <BoxView Style="{StaticResource Separator}" />
                                    <Picker ItemsSource="{x:Static vm:GatesViewModel.Directions}"
                                            ItemDisplayBinding="{Binding Label, x:DataType=vm:Choice}"
                                            SelectedItem="{Binding Direction}" Title="Direction" />
                                </VerticalStackLayout>
                            </Border>
                            <Button Text="Save" Style="{StaticResource FilledButton}" HeightRequest="40" HorizontalOptions="End"
                                    Margin="0,8,0,0" IsVisible="{Binding Dirty}"
                                    Command="{Binding Vm.SaveCommand, Source={x:Reference Page}, x:DataType=p:GatesPage}"
                                    CommandParameter="{Binding .}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
                <BindableLayout.EmptyView>
                    <Label Text="Gates appear here once their controllers connect." Style="{StaticResource Subhead}" Margin="4,20" />
                </BindableLayout.EmptyView>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</p:PageBase>

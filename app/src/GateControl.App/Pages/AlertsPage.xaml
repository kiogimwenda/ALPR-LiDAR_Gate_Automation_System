<?xml version="1.0" encoding="utf-8" ?>
<!-- Alerts — the reference's two-pane "Messages" layout (spec §10): the
     alert list on the left; on wide windows the tapped vehicle's history in
     the pane on the right (phones push it). Clear one, clear all. -->
<p:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:p="clr-namespace:GateControl.Pages"
            xmlns:c="clr-namespace:GateControl.Controls"
            xmlns:m="clr-namespace:GateControl.Motion"
            xmlns:v="clr-namespace:GateControl.Views"
            xmlns:vm="clr-namespace:GateControl.Core.ViewModels;assembly=GateControl.Core"
            x:Class="GateControl.Pages.AlertsPage"
            x:Name="Page"
            x:DataType="vm:AlertsViewModel">
    <Grid x:Name="Panes" ColumnDefinitions="*" ColumnSpacing="16" RowDefinitions="Auto,*" RowSpacing="16"
          Padding="{OnIdiom Phone='4,4,4,0', Default='8,4,8,0'}">
        <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="4">
                <c:TitleLabel Text="Alerts" />
                <Label Style="{StaticResource Subhead}" m:Reveal.Kind="Row" m:Reveal.Delay="0.1">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Unread}" FontFamily="InterSemiBold" />
                            <Span Text=" open · blocklisted plates, swapped plates, gate faults, failed commands" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Clear all" Style="{StaticResource FilledButton}" HeightRequest="40" VerticalOptions="Center"
                    Command="{Binding AcknowledgeAllCommand}" IsVisible="{Binding CanClearAll}" />
        </Grid>

        <!-- List pane -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16" m:Reveal.Kind="Card" m:Reveal.Order="0">
            <Grid RowDefinitions="Auto,*">
                <c:SegmentedControl x:Name="Filter" Margin="12,12,12,4" />
                <RefreshView Grid.Row="1" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
                    <ScrollView>
                        <VerticalStackLayout Padding="0,4,0,8">
                            <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource Footnote}" Margin="16,4"
                                   TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                            <VerticalStackLayout m:Reveal.Items="True" BindableLayout.ItemsSource="{Binding Items}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AlertRow">
                                        <Grid Padding="12,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                                              m:Pressable.Command="{Binding Vm.ShowPlateCommand, Source={x:Reference Page}, x:DataType=p:AlertsPage}"
                                              m:Pressable.CommandParameter="{Binding .}">
                                            <Grid WidthRequest="40" HeightRequest="40" VerticalOptions="Start">
                                                <Border StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="{Binding Tone, Converter={StaticResource ToneTint}}"/>
                                                <c:IconView Glyph="{x:Static c:Icons.Bell}" Size="16" />
                                                <!-- unread dot (brand) -->
                                                <Border StrokeThickness="0" StrokeShape="Ellipse" WidthRequest="10" HeightRequest="10" HorizontalOptions="End" VerticalOptions="Start"
                                                         BackgroundColor="{StaticResource BrandLight}"
                                                         IsVisible="{Binding IsAcknowledged, Converter={StaticResource Not}}"/>
                                            </Grid>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="{Binding Title}" Style="{StaticResource Callout}" FontFamily="InterSemiBold" />
                                                <Label Text="{Binding Message}" Style="{StaticResource Subhead}" />
                                                <Label Style="{StaticResource Caption}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding Severity}" />
                                                            <Span Text=" · " />
                                                            <Span Text="{Binding Gate}" />
                                                            <Span Text=" · " />
                                                            <Span Text="{Binding TimeText}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Label Text="{Binding AcknowledgedText}" Style="{StaticResource Caption}"
                                                       IsVisible="{Binding IsAcknowledged}" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="2" Text="Clear" Style="{StaticResource TintedButton}" HeightRequest="34"
                                                    VerticalOptions="Start"
                                                    Command="{Binding Vm.AcknowledgeCommand, Source={x:Reference Page}, x:DataType=p:AlertsPage}"
                                                    CommandParameter="{Binding .}"
                                                    IsVisible="{Binding IsAcknowledged, Converter={StaticResource Not}}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                                <BindableLayout.EmptyView>
                                    <Label Text="{Binding EmptyText}" Style="{StaticResource Subhead}" Margin="16,24" HorizontalTextAlignment="Center" />
                                </BindableLayout.EmptyView>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>
                </RefreshView>
            </Grid>
        </Border>

        <!-- Detail pane (wide windows) -->
        <Grid x:Name="DetailPane" Grid.Row="1" Grid.Column="1" IsVisible="False" m:Reveal.Kind="Card" m:Reveal.Order="1">
            <Border x:Name="DetailEmpty" Style="{StaticResource Card}" VerticalOptions="Start">
                <VerticalStackLayout Spacing="6" Padding="4,8">
                    <c:IconView Glyph="{x:Static c:IconsExtra.Vehicle}" Size="22" HorizontalOptions="Start" />
                    <Label Text="Select an alert" Style="{StaticResource Headline}" />
                    <Label Text="The vehicle's visits and every decision about it show here." Style="{StaticResource Subhead}" />
                </VerticalStackLayout>
            </Border>
            <v:PlateHistoryView x:Name="Detail" IsVisible="False" />
        </Grid>
    </Grid>
</p:PageBase>

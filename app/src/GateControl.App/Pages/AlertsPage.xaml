<?xml version="1.0" encoding="utf-8" ?>
<p:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:p="clr-namespace:GateControl.Pages"
            xmlns:c="clr-namespace:GateControl.Controls"
            xmlns:m="clr-namespace:GateControl.Motion"
            xmlns:vm="clr-namespace:GateControl.Core.ViewModels;assembly=GateControl.Core"
            x:Class="GateControl.Pages.AlertsPage"
            x:Name="Page"
            x:DataType="vm:AlertsViewModel">
    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="16,8,16,32" MaximumWidthRequest="900">
                <c:SegmentedControl x:Name="Filter" Margin="0,4,0,8" />
                <Grid ColumnDefinitions="*,Auto" Margin="2,10,2,6">
                    <Label VerticalOptions="Center" Style="{StaticResource Subhead}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Unread}" FontAttributes="Bold" />
                                <Span Text=" open" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Button Grid.Column="1" Text="Clear all" Style="{StaticResource TintedButton}" HeightRequest="34"
                            Command="{Binding AcknowledgeAllCommand}" IsVisible="{Binding CanClearAll}" />
                </Grid>
                <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource Footnote}"
                       TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}"
                       Margin="2,0,2,8" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AlertRow">
                            <Border Style="{StaticResource Card}" Padding="14,12"
                                    m:Pressable.Command="{Binding Vm.ShowPlateCommand, Source={x:Reference Page}, x:DataType=p:AlertsPage}"
                                    m:Pressable.CommandParameter="{Binding .}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Ellipse WidthRequest="10" HeightRequest="10" VerticalOptions="Start" Margin="0,6,0,0"
                                             Fill="{Binding Tone, Converter={StaticResource ToneColor}}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Title}" Style="{StaticResource Headline}" />
                                        <Label Text="{Binding Message}" Style="{StaticResource Callout}" />
                                        <Label Style="{StaticResource Caption}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Severity}" />
                                                    <Span Text=" · " />
                                                    <Span Text="{Binding Gate}" />
                                                    <Span Text=" · " />
                                                    <Span Text="{Binding TimeText}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label Text="{Binding AcknowledgedText}" Style="{StaticResource Caption}"
                                               IsVisible="{Binding IsAcknowledged}" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="2" Text="Clear" Style="{StaticResource TintedButton}" HeightRequest="34"
                                            VerticalOptions="Start"
                                            Command="{Binding Vm.AcknowledgeCommand, Source={x:Reference Page}, x:DataType=p:AlertsPage}"
                                            CommandParameter="{Binding .}"
                                            IsVisible="{Binding IsAcknowledged, Converter={StaticResource Not}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                    <BindableLayout.EmptyView>
                        <Label Text="{Binding EmptyText}" Style="{StaticResource Subhead}" Margin="2,24" HorizontalTextAlignment="Center" />
                    </BindableLayout.EmptyView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</p:PageBase>

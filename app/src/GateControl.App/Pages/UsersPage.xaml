<?xml version="1.0" encoding="utf-8" ?>
<p:PageBase xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            xmlns:p="clr-namespace:GateControl.Pages"
            xmlns:c="clr-namespace:GateControl.Controls"
            xmlns:m="clr-namespace:GateControl.Motion"
            xmlns:vm="clr-namespace:GateControl.Core.ViewModels;assembly=GateControl.Core"
            xmlns:models="clr-namespace:GateControl.Core.Models;assembly=GateControl.Core"
            x:Class="GateControl.Pages.UsersPage"
            x:Name="Page"
            x:DataType="vm:UsersViewModel"
            Title="">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="{OnIdiom Phone='16,8,16,32', Default='28,12,28,32'}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,0,0,16">
                    <VerticalStackLayout Spacing="4">
                        <c:TitleLabel Text="Users and roles" />
                        <Label Text="Who can sign in, and what each role may do." Style="{StaticResource Subhead}"
                               m:Reveal.Kind="Row" m:Reveal.Delay="0.1" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="+  Add user" Style="{StaticResource FilledButton}" HeightRequest="40"
                            VerticalOptions="Center" Command="{Binding AddCommand}" m:Reveal.Kind="Row" m:Reveal.Delay="0.15" />
                </Grid>
                <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource Footnote}" Margin="2,0,2,8"
                       TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                <Border Style="{StaticResource Card}" Padding="0,8" m:Reveal.Kind="Card" m:Reveal.Order="0">
                    <VerticalStackLayout m:Reveal.Items="True" BindableLayout.ItemsSource="{Binding Items}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:UserAccount">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Delete" BackgroundColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}"
                                                       Command="{Binding Vm.DeleteCommand, Source={x:Reference Page}, x:DataType=p:UsersPage}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>
                                    <Grid Padding="16,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                                          BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                          m:Pressable.Command="{Binding Vm.EditCommand, Source={x:Reference Page}, x:DataType=p:UsersPage}"
                                          m:Pressable.CommandParameter="{Binding .}">
                                        <Grid WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                                            <Border StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="{AppThemeBinding Light={StaticResource WellLight}, Dark={StaticResource WellDark}}"/>
                                            <c:IconView Glyph="{x:Static c:Icons.User}" Size="16" />
                                        </Grid>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding Username}" Style="{StaticResource Callout}" FontFamily="InterSemiBold" />
                                            <Label Text="{Binding FullName}" Style="{StaticResource Caption}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                            <Label Text="{Binding Role, Converter={StaticResource RoleText}}" Style="{StaticResource Subhead}" HorizontalOptions="End" />
                                            <Label Text="Disabled" Style="{StaticResource Caption}" HorizontalOptions="End"
                                                   IsVisible="{Binding Active, Converter={StaticResource Not}}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </SwipeView>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
                <Label Style="{StaticResource Footnote}" Margin="4,10" m:Reveal.Kind="Row" m:Reveal.Order="4"
                       Text="Viewers see reports. Operators also run the gates, clear alerts and manage registered vehicles. Administrators also manage users, gates and data." />
            </VerticalStackLayout>
        </ScrollView>

        <c:Sheet IsOpen="{Binding Editor, Converter={StaticResource NotNull}, Mode=OneWay}"
                 DismissCommand="{Binding Editor.CancelCommand, FallbackValue={x:Null}}">
            <c:Sheet.SheetContent>
                <ScrollView>
                    <VerticalStackLayout x:Name="EditorForm" Padding="16,0,16,16" x:DataType="vm:UserEditorViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Button Text="Cancel" Style="{StaticResource PlainButton}" Command="{Binding CancelCommand}" />
                            <Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource Headline}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <Button Grid.Column="2" Text="Save" Style="{StaticResource PlainButton}" FontAttributes="Bold"
                                    Command="{Binding SaveCommand}" />
                        </Grid>
                        <Label Text="Account" Style="{StaticResource SectionHeader}" Margin="4,16,4,6" />
                        <Border Style="{StaticResource SheetCard}" Padding="16,2">
                            <VerticalStackLayout>
                                <Entry Text="{Binding Username}" Placeholder="Username" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />
                                <BoxView Style="{StaticResource Separator}" />
                                <Entry Text="{Binding FullName}" Placeholder="Full name" />
                                <BoxView Style="{StaticResource Separator}" />
                                <Entry Text="{Binding Email}" Placeholder="Email" Keyboard="Email" />
                                <BoxView Style="{StaticResource Separator}" />
                                <Entry Text="{Binding Password}" Placeholder="{Binding PasswordHint}" IsPassword="True" />
                            </VerticalStackLayout>
                        </Border>
                        <Label Text="Role" Style="{StaticResource SectionHeader}" Margin="4,18,4,6" />
                        <Border Style="{StaticResource SheetCard}" Padding="16,2">
                            <VerticalStackLayout>
                                <Picker ItemsSource="{x:Static vm:UserEditorViewModel.Roles}"
                                        ItemDisplayBinding="{Binding Label, x:DataType=vm:Choice}" SelectedItem="{Binding Role}" />
                                <BoxView Style="{StaticResource Separator}" />
                                <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="44">
                                    <Label Text="Can sign in" VerticalOptions="Center" />
                                    <Switch Grid.Column="1" IsToggled="{Binding Active}" VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                        <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource Footnote}" Margin="4,12,4,0"
                               TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
                    </VerticalStackLayout>
                </ScrollView>
            </c:Sheet.SheetContent>
        </c:Sheet>
    </Grid>
</p:PageBase>

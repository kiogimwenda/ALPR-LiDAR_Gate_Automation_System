<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Styles.xaml — type ramp, surfaces and controls.

  Type: Inter (bundled as "Inter GC": tabular figures frozen in, so
  counting numbers never jitter; Resources/Fonts/OFL.txt). Sizes, weights
  and tracking follow the reference design (docs/design-video-spec.md
  §4): tracking tightens as type grows (−0.03 em at hero size → 0 at
  body). CharacterSpacing is in device-independent units.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===================== implicit ===================== -->

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LabelLight}, Dark={StaticResource LabelDark}}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LabelLight}, Dark={StaticResource LabelDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TertiaryLabelLight}, Dark={StaticResource TertiaryLabelDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LabelLight}, Dark={StaticResource LabelDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource TertiaryLabelLight}, Dark={StaticResource TertiaryLabelDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LabelLight}, Dark={StaticResource LabelDark}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource SecondaryLabelLight}, Dark={StaticResource SecondaryLabelDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LabelLight}, Dark={StaticResource LabelDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="InterSemiBold" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
        <Setter Property="ThumbColor" Value="{AppThemeBinding Light={StaticResource BrandLight}, Dark={StaticResource BrandDark}}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource SecondaryLabelLight}, Dark={StaticResource SecondaryLabelDark}}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{AppThemeBinding Light={StaticResource SecondaryLabelLight}, Dark={StaticResource SecondaryLabelDark}}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}" />
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="Shell.TitleColor" Value="{AppThemeBinding Light={StaticResource LabelLight}, Dark={StaticResource LabelDark}}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource ChromeLight}, Dark={StaticResource ChromeDark}}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource NeutralLight}" />
        <Setter Property="Shell.FlyoutBackgroundColor" Value="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource SurfaceDark}}" />
    </Style>

    <!-- ===================== type ramp ===================== -->

    <!-- Page title (A2 word reveal): "Rewards Program" 32/600. -->
    <Style x:Key="LargeTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="CharacterSpacing" Value="-0.64" />
        <Setter Property="LineHeight" Value="1.05" />
    </Style>

    <Style x:Key="Title1" TargetType="Label">
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="CharacterSpacing" Value="-0.56" />
        <Setter Property="LineHeight" Value="1.08" />
    </Style>

    <Style x:Key="Title2" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="CharacterSpacing" Value="-0.33" />
    </Style>

    <Style x:Key="Title3" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="CharacterSpacing" Value="-0.2" />
    </Style>

    <!-- Card title: "Tier benefits" 15/600. -->
    <Style x:Key="Headline" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CharacterSpacing" Value="-0.1" />
    </Style>

    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Row title: 14/500. -->
    <Style x:Key="Callout" TargetType="Label">
        <Setter Property="FontFamily" Value="InterMedium" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="Subhead" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SecondaryLabelLight}, Dark={StaticResource SecondaryLabelDark}}" />
    </Style>

    <Style x:Key="Footnote" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SecondaryLabelLight}, Dark={StaticResource SecondaryLabelDark}}" />
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SecondaryLabelLight}, Dark={StaticResource SecondaryLabelDark}}" />
    </Style>

    <!-- Section header above a card. -->
    <Style x:Key="SectionHeader" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="4,22,4,8" />
    </Style>

    <!-- Plates: heavy, slightly spaced, as printed. -->
    <Style x:Key="Plate" TargetType="Label">
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="CharacterSpacing" Value="1.0" />
    </Style>

    <!-- Card number: "$635,386.60" 28/700, tabular. -->
    <Style x:Key="BigNumber" TargetType="Label">
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="CharacterSpacing" Value="-0.56" />
    </Style>

    <!-- Hero number on the accent card: "12,480" 56/600, tabular. -->
    <Style x:Key="HeroNumber" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="56" />
        <Setter Property="CharacterSpacing" Value="-1.7" />
        <Setter Property="TextColor" Value="White" />
    </Style>

    <!-- ===================== surfaces ===================== -->

    <!-- A card: flat surface on the tinted canvas, radius 20, no shadow. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
    </Style>

    <!-- A card inside a sheet steps up one elevation in dark. -->
    <Style x:Key="SheetCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceRaisedDark}}" />
    </Style>

    <!-- A recessed well inside a card (fields, tiles, table header). -->
    <Style x:Key="Inset" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WellLight}, Dark={StaticResource WellDark}}" />
    </Style>

    <Style x:Key="Well" TargetType="Border" BasedOn="{StaticResource Inset}">
        <Setter Property="Padding" Value="12" />
    </Style>

    <!-- The accent tile / hero card: orange radial gradient, white text.
         The reference's soft coloured glow is left out: on Windows a MAUI
         shadow under the animated blob clip (A6) cost 18–25 ms frames, and
         toggling it around the reveal made MAUI's WrapperView throw. -->
    <Style x:Key="AccentCard" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background">
            <RadialGradientBrush Center="0.7,0.3" Radius="0.9">
                <GradientStop Color="{StaticResource BrandHighlight}" Offset="0" />
                <GradientStop Color="{StaticResource BrandLight}" Offset="0.55" />
                <GradientStop Color="{StaticResource BrandDeep}" Offset="1" />
            </RadialGradientBrush>
        </Setter>
    </Style>

    <!-- Floating capsule of the shell (brand, nav, icons, profile, rail). -->
    <Style x:Key="Capsule" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <Style x:Key="Separator" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource HairlineLight}, Dark={StaticResource HairlineDark}}" />
    </Style>

    <!-- ===================== buttons ===================== -->
    <!-- Every button reacts on touch-down (Pressable, Motion.cs), not release.
         All buttons are capsules. -->

    <!-- Primary: ink capsule ("Transfer", "+ New card"). -->
    <Style x:Key="FilledButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OnInkLight}, Dark={StaticResource OnInkDark}}" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <!-- Secondary: well capsule with ink text ("Request"). -->
    <Style x:Key="TintedButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WellLight}, Dark={StaticResource FillDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style x:Key="DestructiveButton" TargetType="Button" BasedOn="{StaticResource TintedButton}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#1FE5484D, Dark=#33F2555A}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />
    </Style>

    <!-- On the accent card: white capsule, ink text ("Redeem points"). -->
    <Style x:Key="OnBrandButton" TargetType="Button" BasedOn="{StaticResource TintedButton}">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="{StaticResource InkLight}" />
    </Style>

    <Style x:Key="PlainButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="44" />
    </Style>

</ResourceDictionary>

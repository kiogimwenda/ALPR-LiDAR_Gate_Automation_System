<?xml version="1.0" encoding="utf-8" ?>
<!-- PlateHistoryView — one plate's history (spec §10 "Plate history"):
     a Surface hero with the plate printed large and its registration chip,
     the facts as count-up tiles, then visits and decisions as history
     lists. Used by the pushed PlateDetailPage and by the detail pane of
     the two-pane Alerts and Reports layouts on wide windows. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:GateControl.Motion"
             xmlns:c="clr-namespace:GateControl.Controls"
             xmlns:vm="clr-namespace:GateControl.Core.ViewModels;assembly=GateControl.Core"
             xmlns:models="clr-namespace:GateControl.Core.Models;assembly=GateControl.Core"
             x:Class="GateControl.Views.PlateHistoryView"
             x:DataType="vm:PlateDetailViewModel">
    <ScrollView>
        <VerticalStackLayout x:Name="Body" Spacing="16" Padding="0,0,0,24">
            <!-- Hero -->
            <Border Style="{StaticResource Card}" Padding="20" m:Reveal.Kind="Card" m:Reveal.Order="0">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
                    <Border StrokeThickness="2" StrokeShape="RoundRectangle 12" Padding="18,6" HorizontalOptions="Start"
                            Stroke="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}">
                        <Label Text="{Binding Plate}" FontFamily="InterBold" FontSize="32" CharacterSpacing="2" />
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Chip}" VerticalOptions="Start"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PositiveTintLight}, Dark={StaticResource PositiveTintDark}}"
                            IsVisible="{Binding IsRegistered}">
                        <Label Text="Registered" FontFamily="InterSemiBold" FontSize="12"
                               TextColor="{AppThemeBinding Light={StaticResource PositiveLight}, Dark={StaticResource PositiveDark}}" />
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Chip}" VerticalOptions="Start"
                            BackgroundColor="{AppThemeBinding Light={StaticResource WellLight}, Dark={StaticResource WellDark}}"
                            IsVisible="{Binding IsRegistered, Converter={StaticResource Not}}">
                        <Label Text="Not registered" FontFamily="InterSemiBold" FontSize="12" Style="{StaticResource Caption}" />
                    </Border>
                    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Registration}" Style="{StaticResource Subhead}"
                           IsVisible="{Binding Registration, Converter={StaticResource HasText}}" />
                </Grid>
            </Border>
            <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource Footnote}"
                   TextColor="{AppThemeBinding Light={StaticResource NegativeLight}, Dark={StaticResource NegativeDark}}" />

            <!-- Facts -->
            <Border Style="{StaticResource Card}" Padding="8" m:Reveal.Kind="Card" m:Reveal.Order="1">
                <c:TileGrid m:Reveal.Items="True" BindableLayout.ItemsSource="{Binding Facts}" MinTileWidth="150" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:Metric">
                            <Border Style="{StaticResource Well}" Padding="14,12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Title}" Style="{StaticResource Footnote}" />
                                    <Label m:CountUp.Key="{Binding Title, StringFormat='plate:{0}'}" m:CountUp.Text="{Binding Value}"
                                           Style="{StaticResource Title2}" />
                                    <Label Text="{Binding Caption}" Style="{StaticResource Caption}"
                                           IsVisible="{Binding Caption, Converter={StaticResource HasText}}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </c:TileGrid>
            </Border>

            <!-- Visits -->
            <Border Style="{StaticResource Card}" Padding="0,14,0,6" m:Reveal.Kind="Card" m:Reveal.Order="2">
                <VerticalStackLayout>
                    <Label Text="Visits" Style="{StaticResource Headline}" Margin="16,0,16,6" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Visits}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:SessionRow">
                                <Grid Padding="16,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Grid WidthRequest="36" HeightRequest="36">
                                        <Border StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="{AppThemeBinding Light={StaticResource WellLight}, Dark={StaticResource WellDark}}"/>
                                        <c:IconView Glyph="{x:Static c:Icons.DoorOpen}" Size="16" />
                                    </Grid>
                                    <Label Grid.Column="1" Text="{Binding Entered, Converter={StaticResource LocalTime}}" Style="{StaticResource Callout}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource Subhead}" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                        <BindableLayout.EmptyView>
                            <Label Text="Visits appear once entry and exit gates are set (Settings → Gates)."
                                   Style="{StaticResource Subhead}" Padding="16,8,16,10" />
                        </BindableLayout.EmptyView>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Decisions -->
            <Border Style="{StaticResource Card}" Padding="0,14,0,6" m:Reveal.Kind="Card" m:Reveal.Order="3">
                <VerticalStackLayout>
                    <Label Text="History" Style="{StaticResource Headline}" Margin="16,0,16,6" />
                    <VerticalStackLayout m:Reveal.Items="True" BindableLayout.ItemsSource="{Binding History}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:DecisionRow">
                                <Grid Padding="16,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Grid WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                                        <Border StrokeThickness="0" StrokeShape="Ellipse" BackgroundColor="{Binding Tone, Converter={StaticResource ToneTint}}"/>
                                        <c:IconView Glyph="{x:Static c:IconsExtra.Vehicle}" Size="16" />
                                    </Grid>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding When, Converter={StaticResource LocalTime}}" Style="{StaticResource Callout}" />
                                        <Label Style="{StaticResource Caption}" LineBreakMode="TailTruncation">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Detail}" />
                                                    <Span Text="  " />
                                                    <Span Text="{Binding Reason}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" Style="{StaticResource Chip}" VerticalOptions="Center"
                                            BackgroundColor="{Binding Tone, Converter={StaticResource ToneTint}}">
                                        <Label Text="{Binding Verdict}" FontFamily="InterSemiBold" FontSize="12"
                                               TextColor="{Binding Tone, Converter={StaticResource ToneColor}}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>

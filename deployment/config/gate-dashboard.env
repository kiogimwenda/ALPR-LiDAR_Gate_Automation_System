# /etc/gate/gate-dashboard.env — runtime configuration for the
# dashboard backend. Referenced by gate-dashboard.service.

LISTEN_HOST=0.0.0.0
LISTEN_PORT=8080

# The gate-server gRPC endpoint (usually the same host).
GRPC_SERVER=127.0.0.1:50051

SITE_ID=site-01

# TLS toward gate-server (Phase 4.10.1). The CA turns TLS on; the
# cert/key pair is this backend's client identity for mTLS. Empty =
# plaintext (dev only). Uncomment for production:
#TLS_EXTRA_ARGS=--tls-ca /etc/gate/tls/ca.pem --tls-cert /etc/gate/tls/dashboard.pem --tls-key /etc/gate/tls/dashboard.key
TLS_EXTRA_ARGS=

# JWT admin auth (Phase 4.10.2). Mint the credential once with
# scripts/gen-admin-hash.sh; the optional secret file (any single
# line of high-entropy text, mode 0640 root:gate) keeps admin
# sessions valid across backend restarts. Empty = admin surface
# open — dev only; the backend logs a warning. Uncomment for
# production:
#AUTH_EXTRA_ARGS=--admin-user admin --admin-password-hash pbkdf2-sha256$210000$... --jwt-secret-file /etc/gate/jwt.secret
AUTH_EXTRA_ARGS=

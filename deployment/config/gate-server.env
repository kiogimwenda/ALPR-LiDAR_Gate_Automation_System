# /etc/gate/gate-server.env — runtime configuration for gate-server.
# Referenced by deployment/systemd/gate-server.service.

# gRPC listen address (firmware, gate-sim, and the dashboard backend
# all dial this).
LISTEN_ADDRESS=0.0.0.0:50051

# Site identifier — must match the dashboard backend and any
# allowlist tooling.
SITE_ID=site-01

# SQLite allowlist/audit store (inside the unit's StateDirectory).
DB_PATH=/var/lib/gate/gate.db

# TLS/mTLS (Phase 4.10.1). Generate the site PKI once with
# scripts/gen-tls-certs.sh and install it under /etc/gate/tls (owned
# root:gate, keys mode 0640). Empty = plaintext — dev only; the server
# logs a warning at startup. Uncomment for production:
#TLS_EXTRA_ARGS=--tls-cert /etc/gate/tls/server.pem --tls-key /etc/gate/tls/server.key --tls-ca /etc/gate/tls/ca.pem --require-client-cert
TLS_EXTRA_ARGS=

# Fusion policy. Default: ALPR and LiDAR weighted equally, 0.7 floor, so a
# plate read needs a LiDAR-confirmed vehicle to open the gate. A site
# without a LiDAR must opt in to plate-only decisions explicitly; vehicle
# class restrictions on allowlist entries then cannot be enforced.
#FUSION_ARGS=--plate-only
#FUSION_ARGS=--alpr-weight 0.6 --lidar-weight 0.4 --min-confidence 0.7
FUSION_ARGS=

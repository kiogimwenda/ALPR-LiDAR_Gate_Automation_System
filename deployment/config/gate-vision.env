# /etc/gate/gate-vision.env — runtime configuration for gate-vision.
# Referenced by deployment/systemd/gate-vision.service.

# gate-server gRPC address (usually loopback — same GPU host).
SERVER_ADDRESS=127.0.0.1:50051

# Site identifier — must match gate-server.
SITE_ID=site-01

# The gate this camera watches; stamped on every DetectionFrame and
# the target of the auto-dispatched OPEN_GATE on an authorized read.
GATE_ID=gate-01

# Source selection (exactly one form).
#
# Production — the ADR-007 camera over RTSP through the TensorRT ALPR
# engines. Engines are built on this host's GPU (any RTX 20-series or
# newer) by `install-server.sh --models <onnx dir>`, which runs
# scripts/export-models/build_engines.sh into /opt/gate/models:
#SOURCE_ARGS=--camera rtsp://user:pass@192.168.1.10:554/Streaming/Channels/101 --detector-engine /opt/gate/models/yolov9_plate.plan --recognizer-engine /opt/gate/models/ppocrv4_rec.plan --ocr-dictionary /opt/gate/models/dict_kenya_plates.txt
#
# Add the LiDAR (docs/lidar.md) to either form, e.g. the Unitree L1 on
# USB-serial (service account in the dialout group; gate-vision built
# with -DUNITREE_LIDAR_SDK_DIR) and the commissioned site config:
#   … --lidar unitree-serial:/dev/ttyUSB0 --lidar-config /etc/gate/lidar.json
# Without a LiDAR, gate-server must run with FUSION_ARGS=--plate-only.
#
# Camera-less dry run (bench validation, demos) — a scripted scenario:
#SOURCE_ARGS=--scenario /etc/gate/vision-scenario.json
SOURCE_ARGS=

# mTLS client credentials (Phase 4.10.1 site PKI — same ladder as
# every other process; empty = plaintext, dev only, loudly logged).
#TLS_EXTRA_ARGS=--tls-ca /etc/gate/tls/ca.pem --tls-cert /etc/gate/tls/vision.pem --tls-key /etc/gate/tls/vision.key
TLS_EXTRA_ARGS=
